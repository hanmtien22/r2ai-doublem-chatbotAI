{
  "ROE": {
    "name": "Ty suat loi nhuan tren von chu so huu",
    "name_en": "Return on Equity",
    "formula": "IS.60 / BS.400",
    "components": ["IS.60", "BS.400"],
    "unit": "%",
    "multiply_100": true,
    "requires_previous_year": false
  },
  "ROA": {
    "name": "Ty suat loi nhuan tren tong tai san",
    "name_en": "Return on Assets",
    "formula": "IS.60 / BS.270",
    "components": ["IS.60", "BS.270"],
    "unit": "%",
    "multiply_100": true,
    "requires_previous_year": false
  },
  "gross_margin": {
    "name": "Bien loi nhuan gop",
    "name_en": "Gross Profit Margin",
    "formula": "IS.20 / IS.10",
    "components": ["IS.20", "IS.10"],
    "unit": "%",
    "multiply_100": true,
    "requires_previous_year": false
  },
  "net_margin": {
    "name": "Bien loi nhuan rong",
    "name_en": "Net Profit Margin",
    "formula": "IS.60 / IS.10",
    "components": ["IS.60", "IS.10"],
    "unit": "%",
    "multiply_100": true,
    "requires_previous_year": false
  },
  "operating_margin": {
    "name": "Bien loi nhuan hoat dong",
    "name_en": "Operating Margin",
    "formula": "IS.30 / IS.10",
    "components": ["IS.30", "IS.10"],
    "unit": "%",
    "multiply_100": true,
    "requires_previous_year": false
  },
  "EPS": {
    "name": "Loi nhuan tren moi co phieu",
    "name_en": "Earnings Per Share",
    "formula": "IS.70 / so_luong_co_phieu",
    "components": ["IS.70"],
    "unit": "VND/co phieu",
    "multiply_100": false,
    "requires_previous_year": false
  },
  "current_ratio": {
    "name": "He so thanh toan ngan han",
    "name_en": "Current Ratio",
    "formula": "BS.100 / BS.310",
    "components": ["BS.100", "BS.310"],
    "unit": "lan",
    "multiply_100": false,
    "requires_previous_year": false
  },
  "debt_to_equity": {
    "name": "He so no tren von chu so huu",
    "name_en": "Debt to Equity Ratio",
    "formula": "BS.300 / BS.400",
    "components": ["BS.300", "BS.400"],
    "unit": "lan",
    "multiply_100": false,
    "requires_previous_year": false
  },
  "revenue_growth": {
    "name": "Tang truong doanh thu",
    "name_en": "Revenue Growth",
    "formula": "(IS.10[t] - IS.10[t-1]) / IS.10[t-1]",
    "components": ["IS.10"],
    "unit": "%",
    "multiply_100": true,
    "requires_previous_year": true
  },
  "profit_growth": {
    "name": "Tang truong loi nhuan",
    "name_en": "Profit Growth",
    "formula": "(IS.60[t] - IS.60[t-1]) / IS.60[t-1]",
    "components": ["IS.60"],
    "unit": "%",
    "multiply_100": true,
    "requires_previous_year": true
  },
  "asset_turnover": {
    "name": "Vong quay tong tai san",
    "name_en": "Asset Turnover",
    "formula": "IS.10 / BS.270",
    "components": ["IS.10", "BS.270"],
    "unit": "lan",
    "multiply_100": false,
    "requires_previous_year": false
  },
  "inventory_turnover": {
    "name": "Vong quay hang ton kho",
    "name_en": "Inventory Turnover",
    "formula": "IS.11 / BS.141",
    "components": ["IS.11", "BS.141"],
    "unit": "lan",
    "multiply_100": false,
    "requires_previous_year": false
  }
}
